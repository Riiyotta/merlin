{
  "id": "legal.body",
  "category": "legal",
  "description": "Sticky 'On this page' TOC (no scroll-spy; :target colors the heading) beside the prose article: h2 sections with p / h3 / ul / contact-link blocks, then the document footer (contact + back to top). BODY TEXT IS PLACEHOLDER in the clone.",
  "evidenceLevel": "measured",
  "domAnchor": "div.legal-columns",
  "variants": [],
  "constraints": {
    "onePerPage": true
  },
  "variantRules": [],
  "content": {
    "type": "object",
