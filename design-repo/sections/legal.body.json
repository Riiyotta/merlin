          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "blocks"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "x-sample": "information"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "x-maxWords": 6
            },
            "blocks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "text"
                    ],
                    "properties": {
                      "type": {
                        "const": "p"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "x-maxWords": 82
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "text"
                    ],
                    "properties": {
                      "type": {
                        "const": "h3"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "x-maxWords": 3
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "items"
                    ],
                    "properties": {
                      "type": {
                        "const": "ul"
                      },
                      "items": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 6,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "x-maxWords": 79
                        },
                        "x-maxWordsTotal": 79
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "label",
                      "email"
                    ],
                    "properties": {
                      "type": {
                        "const": "contact-link"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "x-maxWords": 3
                      },
                      "email": {
                        "type": "string",
                        "pattern": "^[^@\\s]+@[^@\\s]+$",
                        "x-sample": "contact@example.com"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "footer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contactLabel",
          "contactEmail",
          "topLabel"
        ],
        "properties": {
          "contactLabel": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 3
          },
          "contactEmail": {
            "type": "string",
            "pattern": "^[^@\\s]+@[^@\\s]+$",
            "x-sample": "contact@example.com"
          },
          "topLabel": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 3
          }
        }
      }
    }
  },
